{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreeCell",
  "version": "0.1.0",
  "identifier": "com.codexu.freecell",
  "build": {
    "beforeDevCommand": "pnpm icons:sync && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm icons:sync && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "空当接龙 · FreeCell",
      "backgroundColor": "#163e32",
      "width": 1100,
      "height": 850,
      "minWidth": 320,
      "minHeight": 480,
      "dragDropEnabled": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "iOS": { "minimumSystemVersion": "15.0" },
    "android": { "minSdkVersion": 24 }
  }
}
